# Optional: free PvP/Practice Cup work without these settings.
HOST=127.0.0.1
PORT=5174
PUBLIC_ORIGIN=http://localhost:5174
DATABASE_PATH=./data/house-cup.sqlite
# Split hosting: frontend PUBLIC_ORIGIN plus backend socket hostname (no scheme).
PUBLIC_WS_ADDRESS=
# Comma-separated exact origins, e.g. the backend's own HTTPS origin.
ADDITIONAL_ALLOWED_ORIGINS=

# Monad testnet only. Never commit private keys.
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
CUP_ESCROW_ADDRESS=
DUEL_ESCROW_ADDRESS=
DUEL_TREASURY_ADDRESS=
DUEL_FEE_BPS=500
RESULT_SIGNER_PRIVATE_KEY=
RELAY_PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
CONTRACT_OWNER_ADDRESS=
CHAIN_MODE=testnet
# Enable only for a verified testnet release. Record physical-device acceptance separately.
ENABLE_TESTNET_PRIZES=0

# Development-only local mock chain, never labelled AUSD:
# CHAIN_MODE=local-mock
# MONAD_TESTNET_RPC_URL=http://127.0.0.1:8545
# LOCAL_MOCK_TOKEN=
