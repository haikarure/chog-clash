# Load locally: set -a; source contracts/arc-mainnet.env; set +a
# Keep the populated file private and out of Git.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io
ARC_DEPLOYER_ADDRESS=
# Optional: fill this locally to sign from .env, or leave blank to use a keystore.
ARC_DEPLOYER_PRIVATE_KEY=
ARC_OWNER_ADDRESS=
ARC_RESULT_SIGNER_ADDRESS=
ARC_RELAY_ADDRESS=
ARC_TREASURY_ADDRESS=
ARC_DUEL_FEE_BPS=500
# Optional combined deployment gas budget, in native USDC.
# ARC_DEPLOYMENT_BUDGET_USDC=0.1
